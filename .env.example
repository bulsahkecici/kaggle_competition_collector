# ─────────────────────────────────────────────────────────────────────────────
# kaggle_competition_collector — environment variables
#
# Copy this file to ".env" and fill in the values you need.
# The .env file is read automatically at startup via python-dotenv.
# ─────────────────────────────────────────────────────────────────────────────

# ── Browser automation login (optional) ─────────────────────────────────────
# Used ONLY for Playwright browser login, not for the Kaggle API.
# If left empty, you will be asked to log in manually the first time
# (requires --headed mode).  After that, the session is saved locally at
# ~/.kaggle_collector/browser_state.json and reused automatically.
KAGGLE_USERNAME=
KAGGLE_PASSWORD=

# ── Kaggle API credentials ───────────────────────────────────────────────────
# The Kaggle Python package reads credentials from ~/.kaggle/kaggle.json
# by default.  You can override that here if you prefer.
# Format of kaggle.json: {"username": "...", "key": "..."}
# Alternatively set:
#   KAGGLE_USERNAME=your_kaggle_username   ← same as above
#   KAGGLE_KEY=your_kaggle_api_key
KAGGLE_KEY=
